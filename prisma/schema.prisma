// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id @default(cuid())
  name      String
  description String?
  tiers     Tier[]
  features  Feature[]
  quotes    Quote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tier {
  id                String   @id @default(cuid())
  name              String
  basePricePerSeat  Float
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tierFeatures      TierFeature[]
  quotes            Quote[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productId, name])
}

model Feature {
  id          String   @id @default(cuid())
  name        String
  description String?
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tierFeatures TierFeature[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, name])
}

model TierFeature {
  id                  String   @id @default(cuid())
  tierId              String
  tier                Tier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
  featureId           String
  feature             Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  status              String   @default("NOT_AVAILABLE") // INCLUDED | ADDON | NOT_AVAILABLE
  addonPricingModel   String?  // FIXED | PER_SEAT | PERCENTAGE
  addonPrice          Float?
  quoteAddons         QuoteAddon[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tierId, featureId])
}

model Quote {
  id              String   @id @default(cuid())
  name            String
  customerName    String
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  tierId          String
  tier            Tier     @relation(fields: [tierId], references: [id])
  seats           Int
  termLength      String   // MONTHLY | ANNUAL | TWO_YEAR
  discountPercent Float    @default(0)
  totalPrice      Float
  shareToken      String   @unique @default(cuid())
  lineItems       QuoteLineItem[]
  addons          QuoteAddon[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model QuoteLineItem {
  id              String   @id @default(cuid())
  quoteId         String
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  label           String
  calculationNote String?
  amount          Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model QuoteAddon {
  id              String   @id @default(cuid())
  quoteId         String
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tierFeatureId   String
  tierFeature     TierFeature @relation(fields: [tierFeatureId], references: [id])
  seats           Int?
  amount          Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
